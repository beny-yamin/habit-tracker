# Server Port
PORT=5173

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/habitpulse?retryWrites=true&w=majority

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=jaaamin-rox
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@jaaamin-rox.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Optional: Stringified Firebase Service Account JSON credentials
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
